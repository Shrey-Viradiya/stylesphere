---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout
  title="About - StyleSphere"
  description="Learn more about StyleSphere, your go-to fashion blog for trends and tips."
  author="StyleSphere Team"
  url="https://stylesphere.com/about"
>
  <div class="center">
    <section>
      <h1 class="heading">About StyleSphere</h1>
      <div class="paragraph">
        <p>
          Welcome to StyleSphere, where fashion meets inspiration. We are passionate about bringing you the latest trends, style guides, and beauty tips to help you express your unique personality through fashion.
        </p>
        <p>
          Our team of fashion enthusiasts curates content that empowers you to stay stylish and confident in every aspect of life.
        </p>
      </div>
    </section>
  </div>
</BaseLayout>