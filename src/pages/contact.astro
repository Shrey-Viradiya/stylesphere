---
import BaseLayout from "../layouts/BaseLayout.astro";

---

<BaseLayout
  title="Contact - StyleSphere"
  description="Get in touch with StyleSphere for fashion inquiries and collaborations."
  author="StyleSphere Team"
>
  <div class="center">
    <section>
      <h1 class="heading">Contact Us</h1>
      <div class="paragraph">
        <p>
          We'd love to hear from you! Whether you have questions about fashion trends, want to collaborate, or just share your thoughts, feel free to reach out.
        </p>
        <p>
          Email us at: contact@stylesphere.com
        </p>
      </div>
    </section>
  </div>
</BaseLayout>